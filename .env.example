# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose. Used to create agent logins and to receive Meta leads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Business timezone used for "today", My Day and dashboards
NEXT_PUBLIC_APP_TIMEZONE=Asia/Dubai

# Meta Lead Ads webhook (optional, Phase 2)
META_VERIFY_TOKEN=choose-any-random-string
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# Phone notifications (Web Push). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Shared secret the database uses to call the app (must match private.app_config.hook_secret)
HOOK_SECRET=
